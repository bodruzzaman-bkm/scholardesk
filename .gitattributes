* text=auto eol=lf

# Shell scripts must keep LF endings. With CRLF the Alpine container fails to
# start with "bad interpreter", which is a confusing way to learn about git's
# autocrlf setting.
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Binary, never touch.
*.pdf binary
*.sqlite binary
*.png binary
*.jpg binary
