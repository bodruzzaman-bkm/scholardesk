# Keep the build context small and free of anything environment-specific.

.git
.gitignore
.env
.env.*
!.env.example

# Reinstalled inside the image at pinned versions.
node_modules
vendor

# The legacy TypeScript project kept alongside as a reference. It is large and
# has no part in the Laravel build.
scholardesk

# Local data. The deployed app keeps these on its mounted volume instead, so
# shipping them would both bloat the image and overwrite live data on redeploy.
database/*.sqlite
database/*.sqlite-journal
storage/app/public/*
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
public/storage
public/hot

# Rebuilt from source by the assets stage.
public/build

# Laravel's compiled package manifest, generated on THIS machine where dev
# dependencies are installed. Copying it into an image built with --no-dev
# makes package:discover try to load providers that are not there:
#   Class "Laravel\Pail\PailServiceProvider" not found
# The image regenerates it from the packages it actually has.
bootstrap/cache/*.php

# Local tooling and notes.
tests
phpunit.xml
.phpunit.result.cache
.phpunit.cache
.editorconfig
.vscode
.idea
*.md
!README.md
