APP_NAME=ScholarDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -----------------------------------------------------------------
# Gmail SMTP. Port 587 with MAIL_SCHEME=smtp negotiates STARTTLS, which is what
# Gmail expects; Laravel 11+ uses MAIL_SCHEME, not the older MAIL_ENCRYPTION.
#
# MAIL_PASSWORD must be a Google APP PASSWORD, not your account password:
#   1. Google Account -> Security -> turn on 2-Step Verification
#   2. Security -> App passwords -> generate one for "Mail"
#   3. paste the 16 characters below, spaces removed
# Gmail rejects a normal password outright, which reads as "wrong credentials".
#
# MAIL_FROM_ADDRESS must be the same Gmail address, or Gmail rewrites the
# sender and replies go to the wrong place.
# failover, not smtp: config/mail.php defines failover as smtp then log, so a
# missing or wrong app password degrades to the log file instead of throwing.
# That matters because password reset does not catch mail failures - with a
# bare smtp mailer and no credentials, "forgot password" returns a 500.
MAIL_MAILER=failover
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="your-address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend, for hosts that block outbound SMTP. Render's free instances drop
# traffic to ports 25, 465 and 587 — every port SMTP uses — and drop rather
# than refuse it, so a send hangs instead of failing and stalls the whole
# single-process server. Resend takes the message over HTTPS on 443 instead.
#
# Set MAIL_MAILER=resend to use it. With no verified domain a Resend account
# sends only from onboarding@resend.dev and only to the address it was opened
# with, so set MAIL_FROM_ADDRESS to the former and expect the latter.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI assistant -------------------------------------------------------
# Optional. Without a key the app runs fully; only summaries, Q&A and
# literature-review drafts are disabled (they report "not configured").
# Semantic search and related papers work WITHOUT a key - they use the
# local embedding engine in App\Services\EmbeddingService.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Alternative provider:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# Crossref polite pool - identifies you for faster DOI lookups
CROSSREF_MAILTO=
